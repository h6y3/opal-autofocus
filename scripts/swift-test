#!/bin/sh
# Runs `swift test`. Command Line Tools installs keep the Swift Testing macro
# plugin in a subfolder the compiler does not search, so point it there.
PLUGIN_DIR="$(xcode-select -p)/usr/lib/swift/host/plugins/testing"
if [ -d "$PLUGIN_DIR" ]; then
    exec swift test -Xswiftc -plugin-path -Xswiftc "$PLUGIN_DIR" "$@"
fi
exec swift test "$@"
